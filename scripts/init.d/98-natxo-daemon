#!/bin/sh
# 98-natxo-daemon v2: root API + telnet, IDEMPOTENT (does not relaunch if already running)
for p in $(ls /proc | grep -E '^[0-9]+$'); do
  c=$(cat /proc/$p/cmdline 2>/dev/null | tr '\0' ' ')
  case "$c" in
    *natxo-daemon.js*) exit 0 ;;
  esac
done
(setsid /usr/bin/node /media/developer/natxo/daemon/natxo-daemon.js >/dev/null 2>&1 &)
